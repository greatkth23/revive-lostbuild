  "workbookFormulaEvidence": {
    "sourceWorkbook": "시즌3 전용 데미지 계산기.xlsx",
    "sheet": "데미지 계산기",
    "usedRange": "A1:BI106",
    "mainStat": {
      "cell": "M4",
      "formula": "=ROUNDDOWN(SUM(M8:M15)*(1+P8),0)"
    },
    "weaponAttack": {
      "cell": "M5",
      "formula": "=ROUNDDOWN(SUM(M18:M22)*(1+P18),0)"
    },
    "attackPower": {
      "cell": "P4",
      "formula": "=ROUNDDOWN(((M4*M5/6)^0.5*(1+SUM(P25:P26))+SUM(M25:M27))*(1+SUM(P29:P34)),0)"
    },
    "engravingDamage": {
      "cell": "T4",
      "formula": "=(1+T8+V8)*(1+T9+V9)*(1+T11+V11)*(1+T14+V14)*(1+T15+V15)*(1+T16+V16)*(1+T17+V17)*(1+T21+V21)*(1+T22+V22)"
    },
    "skillExpectedDamage": {
      "cell": "BB4",
      "formula": "=SUM(BB8:BB27)"
    },
    "additionalDamage": {
      "cell": "BF4",
      "formula": "=SUM(BF8:BF12)+1"
    },
    "otherDamage": {
      "cell": "BF5",
      "formula": "=(1+BF15)*(1+BF16)*(1+BF17)*(1+BF18)*(1+BF19)*(1+BF20)*(1+BF21)*(1+BF22)*(1+BF23)"
    },
    "finalDamage": {
      "cell": "BI4",
      "formula": "=BI8*BI9*BI10*BI11*BI12"
    },
    "sonicBreakthroughLv1": {
      "cell": "AJ62",
      "overCapRate": "0.10"
    },
    "sonicBreakthroughLv2": {
      "cell": "AK62",
      "overCapRate": "0.20"
    }
  }
